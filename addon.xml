<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.selekt" name="SELEKT" version="1.0.0" provider-name="heg">
	<requires>
		<import addon="script.module.beautifulsoup4" version="4.6.2"/>
		<import addon="script.module.requests" version="2.22.0"/>
		<import addon="script.module.resolveurl" version="5.1.00"/>
		<import addon="xbmc.python" version="3.0.0"/>
	</requires>
	<extension point="xbmc.python.pluginsource" library="default.py">
		<provides>video</provides>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en">SELEKT</summary>
		<description lang="en">Nézd meg a filmeket, sorozatokat vagy az élőt a https://hu.selekt.tv/ oldalról!</description>
		<language>hu</language>
		<platform>all</platform>
		<news>
			1.0.0 - Első verzió
		</news>
		<assets>
		  <icon>icon.png</icon>
		  <fanart></fanart>
		  <screenshot>resources/screenshots/screenshot-1.jpg</screenshot>
		  <screenshot>resources/screenshots/screenshot-2.jpg</screenshot>
		</assets>
	</extension>
</addon>
